{
  "name": "@hai-dau/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "migrate": "node dist/src/migrate-cli.js",
    "community:import": "node dist/src/community-import-cli.js",
    "ai-discovery:run": "node dist/src/ai-discovery-run-cli.js",
    "ai-operations:policy": "node dist/src/ai-operations-policy-cli.js",
    "ai-operations:tick": "node dist/src/ai-operations-tick-cli.js",
    "ai-discovery:materialize": "node dist/src/ai-discovery-materialize-cli.js",
    "ai-automation:status": "node dist/src/ai-automation-status-cli.js",
    "ai-provider-execution": "node dist/src/ai-provider-execution-cli.js",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "start:ai-automation": "node dist/src/ai-automation-worker.js",
    "operator:dev": "node --import tsx src/operator-server.ts",
    "operator": "node dist/src/operator-server.js"
  },
  "dependencies": {
    "bullmq": "5.80.11",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
