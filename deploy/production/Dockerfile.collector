FROM node:22.13.0-bookworm-slim AS backend-build
WORKDIR /app/backend

COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build
RUN npm prune --omit=dev

FROM node:22.13.0-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --chown=node:node app ./app
COPY --chown=node:node data ./data
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node community-watch-report.json ./community-watch-report.json
COPY --chown=node:node --from=backend-build /app/backend/package.json /app/backend/package-lock.json ./backend/
COPY --chown=node:node --from=backend-build /app/backend/node_modules ./backend/node_modules
COPY --chown=node:node --from=backend-build /app/backend/dist ./backend/dist
COPY --chown=node:node deploy/production/run-community-collector.sh ./deploy/production/run-community-collector.sh

USER node
CMD ["sh", "deploy/production/run-community-collector.sh"]
