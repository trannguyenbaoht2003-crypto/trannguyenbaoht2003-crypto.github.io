{
  "name": "loi-dau-truong",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:pages": "GITHUB_PAGES=1 next build --webpack && touch out/.nojekyll",
    "patch:pages-fallback": "node scripts/patch-static-watch-banner.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:ai-discovery-automation && npm run test:ai-operations-policy && npm run test:ai-provider-execution && npm run test:guarded-ai-discovery && npm run test:operator-surface && npm run test:moderation && npm run test:public-data && npm run test:staging-contract && npm run test:release-source && npm run test:production-contract && npm run test:production-pr-validation && npm run test:community-backend-pipeline && npm run test:post-publication-monitoring && npm run test:feedback-intake && npm run build:pages && node --test tests/rendered-html.test.mjs",
    "test:ai-discovery-automation": "node --test tests/ai-discovery-automation-contract.test.mjs",
    "test:ai-operations-policy": "node --test tests/ai-operations-policy-contract.test.mjs",
    "test:ai-provider-execution": "node --test tests/ai-provider-execution-contract.test.mjs",
    "test:guarded-ai-discovery": "node --test tests/guarded-ai-discovery-contract.test.mjs",
    "test:operator-surface": "node --test tests/operator-surface-contract.test.mjs",
    "test:moderation": "node --test tests/community-moderation.test.mjs tests/community-evidence-v2.test.mjs tests/community-evidence-v3.test.mjs tests/community-review-v31.test.mjs",
    "test:public-data": "node --experimental-strip-types --test tests/public-data-adapter.test.ts",
    "test:feedback-client": "node --experimental-strip-types --test tests/feedback-client.test.ts",
    "test:feedback-intake": "node --experimental-strip-types --test tests/feedback-client.test.ts && node --test tests/feedback-intake-contract.test.mjs",
    "test:staging-contract": "node --test tests/staging-deployment.test.mjs",
    "test:release-source": "node --test tests/release-rehearsal-source.test.mjs",
    "test:production-contract": "node --test tests/production-delivery.test.mjs",
    "test:production-pr-validation": "node --test tests/production-pr-validation.test.mjs",
    "test:community-backend-pipeline": "node --test tests/community-backend-pipeline.test.mjs",
    "test:post-publication-monitoring": "node --test tests/post-publication-monitoring.test.mjs",
    "production:smoke": "node scripts/production-smoke.mjs",
    "production:browser-smoke": "node scripts/production-browser-smoke.mjs",
    "release:browser-e2e": "node scripts/release-browser-e2e.mjs",
    "staging:backup-restore": "node scripts/staging-backup-restore.mjs",
    "release:security-gate": "node scripts/release-security-gate.mjs",
    "staging:config": "docker compose --env-file deploy/staging/.env.example -f deploy/staging/compose.yml config",
    "staging:up": "docker compose --env-file deploy/staging/.env.example -f deploy/staging/compose.yml up --build -d --wait",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "staging:down": "docker compose --env-file deploy/staging/.env.example -f deploy/staging/compose.yml down -v --remove-orphans",
    "review:apply": "node scripts/apply-community-review-package.mjs",
    "moderate:community": "node scripts/moderate-community-candidates.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern _next --ignore-pattern out --ignore-pattern node_modules",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:test": "npm --prefix backend test",
    "backend:build": "npm --prefix backend run build",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "sync:public-apis": "node scripts/sync-public-apis.mjs",
    "sync:data": "node scripts/sync-lolhaidou.mjs && node scripts/collect-community-candidates.mjs && node scripts/moderate-community-candidates.mjs && node scripts/validate-community-sources.mjs && node scripts/collect-community-candidates.mjs --validate-only && node scripts/moderate-community-candidates.mjs --validate-only",
    "collect:community": "node scripts/collect-community-candidates.mjs",
    "validate:community": "node scripts/validate-community-sources.mjs && node scripts/collect-community-candidates.mjs --validate-only && node scripts/moderate-community-candidates.mjs --validate-only"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Lõi Đấu Trường"
}
